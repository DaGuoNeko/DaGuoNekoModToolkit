<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NpcSkinMaker.Backend</AssemblyName>
    <RootNamespace>NpcSkinMaker</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Drawing" />
    <!-- Core sources are included by the SDK from this project directory. -->
    <EmbeddedResource Include="Resources/template.zip" LogicalName="template.zip" />
    <EmbeddedResource Include="Resources/template_models.zip" LogicalName="template_models.zip" />
    <EmbeddedResource Include="Resources/npc_compatibility.json" LogicalName="npc_compatibility.json" />
  </ItemGroup>
</Project>
